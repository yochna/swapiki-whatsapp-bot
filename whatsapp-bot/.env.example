# Supabase (PostgREST) — service role for the bot's reads and writes.
# SUPABASE_URL defaults to the production project if left unset.
SUPABASE_URL=https://eusbnfgfurrmrccaxbub.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The WhatsApp destination for the daily digest. A group JID ends in @g.us.
# To find it: add the bot's number to the group, then open the Pairing page
# (GET /) once paired — id@msg.whatsapp.net implies no group id; group ids look
# like 120363012345678901@g.us and are also shown in the /status page.
WHATSAPP_GROUP_JID=

# Shared secret the Cloudflare scheduler sends as `x-send-secret`.
# Must equal the scheduler Worker's WHATSAPP_SECRET.
WHATSAPP_SECRET=

# Optional. Route the WhatsApp socket through a residential/mobile proxy.
# Only needed if you host the bot on a cloud/datacenter IP (Render, AWS, GCP);
# those IPs are blocked from linking. If you run the bot on a home PC you can
# leave this empty. Supports http(s):// and socks5:// URLs, with or without auth:
#   WA_PROXY_URL=http://user:pass@host:port
#   WA_PROXY_URL=socks5://user:pass@host:1080
WA_PROXY_URL=

# FREE OPTION: self-schedule the digest so no Render host and no Cloudflare
# scheduler are needed. Set an hour 0-23 (local time) and the bot posts the
# digest itself once a day while it runs. Leave empty to disable.
#   DIGEST_HOUR=8
DIGEST_HOUR=

# Port for the pairing / health / send-digest server.
PORT=8787

# Remove before running in production; the pairing page shows the QR code.
NODE_ENV=production